<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="BibliotecaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.universidadxyz.sistemabiblioteca.entity.Usuario</class>
        <class>com.universidadxyz.sistemabiblioteca.entity.Libro</class>
        <class>com.universidadxyz.sistemabiblioteca.entity.Prestamo</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
            <property name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://localhost:3306/biblioteca_xyz?serverTimezone=UTC&amp;useSSL=false&amp;allowPublicKeyRetrieval=true" />

            <!-- Configuración de conexión a la base de datos -->
            <property name="jakarta.persistence.jdbc.user" value="notzuzz" />
            <property name="jakarta.persistence.jdbc.password" value="zuzz1212M@_" />
            <property name="hibernate.connection.provider_class"
                value="org.hibernate.engine.jdbc.connections.internal.DriverManagerConnectionProviderImpl" />

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect" />
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>